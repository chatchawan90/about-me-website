---
import '../styles/global.css';
import { SITE } from '../data/site';
import { getImage } from 'astro:assets';
import portrait from '../assets/tee-portrait.png';

interface Props { title: string; description?: string; noindex?: boolean }
const { title, description = 'Chatchawan (Tee) Lakkhananukun, an AI engineer in Bangkok. Explore AI agents, machine learning systems, business decisions and stories from my life.', noindex = false } = Astro.props;
const path = Astro.url.pathname;
const isActive = (p: string) => (p === '/' ? path === '/' : path.startsWith(p));
const fullTitle = title === SITE.name ? 'Chatchawan (Tee) Lakkhananukun · AI Engineer' : `${title} · ${SITE.name}`;
const canonical = new URL(path, Astro.site!);
const sharePortrait = await getImage({ src: portrait, width: 600, format: 'jpeg' });
const imageUrl = new URL(sharePortrait.src, Astro.site!).href;
const personId = new URL('/#person', Astro.site!).href;
const websiteId = new URL('/#website', Astro.site!).href;
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'Person', '@id': personId, name: 'Chatchawan Lakkhananukun', alternateName: SITE.name, url: new URL('/about/', Astro.site!).href, image: imageUrl, jobTitle: SITE.role, sameAs: [SITE.linkedin, SITE.github] },
    { '@type': 'WebSite', '@id': websiteId, url: Astro.site!.href, name: SITE.fullName, inLanguage: 'en', publisher: { '@id': personId } },
    { '@type': path === '/about/' ? 'ProfilePage' : 'WebPage', '@id': canonical.href + '#webpage', url: canonical.href, name: fullTitle, description, inLanguage: 'en', isPartOf: { '@id': websiteId }, author: { '@id': personId }, ...(path === '/about/' ? { mainEntity: { '@id': personId } } : {}) },
  ],
};
---
<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={SITE.fullName} />
    <meta name="google-site-verification" content="0yHKUTKbJIUiTJf7sWXRF8qRo2eygc0NDvl6fR6VM4s" />
    <meta name="msvalidate.01" content="F15D85EEEE9E2FCE1AAB163461B287C7" />
    {noindex ? <meta name="robots" content="noindex, follow" /> : <link rel="canonical" href={canonical} />}
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.fullName} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:alt" content="Chatchawan (Tee) Lakkhananukun" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    {!noindex && <script type="application/ld+json" set:html={JSON.stringify(structuredData).replace(/</g, '\\u003c')} />}
    <script is:inline>
      try {
        document.documentElement.dataset.theme = localStorage.getItem('tee-appearance') === 'dark' ? 'dark' : 'light';
      } catch { /* Light is the default when preferences cannot be stored. */ }
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,500;12..96,700;12..96,800&family=Source+Serif+4:opsz,wght@8..60,400;8..60,600&family=JetBrains+Mono:wght@400;600&display=swap" />
  </head>
  <body class={SITE.draft ? 'is-draft' : ''}>
    {SITE.draft && (
      <div class="draft-bar"><div class="wrap">Draft · <span class="tbc">Highlighted details</span> are awaiting confirmation.</div></div>
    )}
    <header class="top">
      <div class="wrap">
        <a class="mark" href="/">{SITE.name} <span>· Bangkok</span></a>
        <nav aria-label="Main">
          <a href="/work/" aria-current={isActive('/work') ? 'page' : undefined}>Work</a>
          <a href="/story/" aria-current={isActive('/story') ? 'page' : undefined}>My story</a>
          <a href="/about/" aria-current={isActive('/about') ? 'page' : undefined}>About</a>
          <a href="/about/#contact">Contact</a>
          <button id="theme-toggle" type="button" aria-label="Use dark appearance" aria-pressed="false" hidden>Dark mode</button>
        </nav>
      </div>
    </header>
    <slot />
    <footer class="site">
      <div class="wrap">
        <span>Stories from my life and work.</span>
        <span>{SITE.email}</span>
      </div>
    </footer>
    <script>
      const toggle = document.querySelector<HTMLButtonElement>('#theme-toggle');
      if (toggle) {
        const updateAppearanceControl = () => {
          const dark = document.documentElement.dataset.theme === 'dark';
          toggle.textContent = dark ? 'Light mode' : 'Dark mode';
          toggle.setAttribute('aria-label', dark ? 'Use light appearance' : 'Use dark appearance');
          toggle.setAttribute('aria-pressed', String(dark));
        };
        updateAppearanceControl();
        toggle.hidden = false;
        toggle.addEventListener('click', () => {
          const theme = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
          document.documentElement.dataset.theme = theme;
          try { localStorage.setItem('tee-appearance', theme); } catch { /* The current page can still switch. */ }
          updateAppearanceControl();
          window.dispatchEvent(new Event('themechange'));
        });
      }
    </script>
  </body>
</html>
