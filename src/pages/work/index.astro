---
import Base from '../../layouts/Base.astro';
import { PROJECTS, pageUrl } from '../../data/site';
---
<Base title="Work" description="Selected work by Tee Lakkhananukun: production AI, MLOps, system design and the people behind adoption.">
  <main class="wrap">
    <header class="head">
      <div class="label">Work</div>
      <h1>The work, and the decisions behind it</h1>
      <p>Most of this work comes from Chemical Express, where I built the connections between our business systems and later developed sales models and quotation AI. I've written about the problems we were trying to solve, the decisions I made and what it takes to keep the systems useful to the people relying on them.</p>
      <p>For a first read, try <a href="/work/quoting-ai/rollout/">why I made QT smaller</a> or <a href="/work/operations/date-picker/">the date-picker request</a>. If you'd like the technical detail, follow <a href="/work/quoting-ai/orchestration/">an agent through an interrupted quotation</a> or <a href="/work/sales-models/mlops/">a model through a release decision</a>. The project pages below bring the full stories together.</p>
    </header>
    {PROJECTS.map((p) => (
      <section class="proj">
        <a class="ph" href={pageUrl(p.id, '')}>
          <span class="sym">{p.sym}</span>
          <span><b>{p.title}</b><span class="od">{p.oneLiner}</span></span>
        </a>
        {p.pages.length > 1 && (
          <ol>
            {p.pages.filter((x) => x.slug).map((x) => (
              <li>
                {x.status === 'planned'
                  ? <span class="soon"><b>{x.title}</b> <em>Coming</em><br /><span>{x.blurb}</span></span>
                  : <a href={pageUrl(p.id, x.slug)}><b>{x.title}</b><br /><span>{x.blurb}</span></a>}
              </li>
            ))}
          </ol>
        )}
      </section>
    ))}
  </main>
</Base>

<style>
  .head { padding-block: 48px 24px; display: grid; gap: 12px; max-width: 64ch; }
  .head h1 { font-size: clamp(34px, 5vw, 52px); margin: 0; font-weight: 800; }
  .head p { margin: 0; color: var(--muted); font-size: 18px; }
  .proj { border-top: 1px solid var(--line); padding-block: 28px; display: grid; gap: 16px; }
  .ph { display: flex; gap: 14px; align-items: center; text-decoration: none; color: var(--ink); }
  .ph b { font: 700 22px/1.2 var(--f-display); display: block; }
  .ph:hover b { color: var(--accent); }
  .od { color: var(--muted); font-size: 16px; }
  ol { list-style: none; margin: 0; padding: 0 0 0 58px; display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: 10px 24px; }
  li a, li .soon { display: block; text-decoration: none; color: var(--ink); line-height: 1.4; }
  li b { font: 600 16px var(--f-display); }
  li a:hover b { color: var(--accent); }
  li span span, li a span { font-size: 14.5px; color: var(--muted); }
  .soon { opacity: .7; }
  em { font: normal 600 11px var(--f-mono); letter-spacing: .06em; text-transform: uppercase; color: var(--warn); }
  @media (max-width: 600px) { ol { padding-left: 0; } }
</style>
